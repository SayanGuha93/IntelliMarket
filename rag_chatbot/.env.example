# Copy values to your local process environment. Keep real credentials private.
RAG_PROVIDER=fallback
GEMINI_API_KEY=
GEMINI_MODEL=
# gemini-3.8-flash defaults to low. Leave blank to use the adapter default.
GEMINI_THINKING_LEVEL=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
RAG_TIMEOUT_SECONDS=15
RAG_RETRIES=1
RAG_CONTEXT_BYTES=14000
RAG_OUTPUT_TOKENS=768

# Optional standalone REST API settings. Values are read from the process environment.
# RAG_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RAG_API_SESSION_TTL_SECONDS=1800
RAG_API_MAX_SESSIONS=100
RAG_API_MAX_IN_FLIGHT=4
RAG_API_TIMEOUT_SECONDS=45
RAG_API_WARMUP=0
RAG_API_PROVIDER_AUDIT=0
