	column listing = fact_product[product_name] & " (" & fact_product[marketplace] & ":" & fact_product[source_product_id] & ")"
		dataType: string
		lineageTag: 453428a1-bf94-4c13-82f6-2b612209d675
		summarizeBy: none

	column discount_band_order = IF(ISBLANK(fact_product[discount_fraction]), BLANK(), IF(fact_product[discount_fraction] = 0, 0, MIN(4, 1 + INT(fact_product[discount_fraction] * 4))))
		dataType: int64
		lineageTag: 879e7527-2d56-4917-939a-bc15a6575a76
		summarizeBy: none

	column discount_band = IF(ISBLANK(fact_product[discount_band_order]), BLANK(), SWITCH(fact_product[discount_band_order], 0, "0%", 1, ">0% to <25%", 2, "25% to <50%", 3, "50% to <75%", 4, "75% to 100%"))
		dataType: string
		lineageTag: 95c8e257-cbc8-4ed7-a0cc-27fdd49317b5
		summarizeBy: none
		sortByColumn: discount_band_order

	column rating_band_order = IF(ISBLANK(fact_product[rating]), BLANK(), INT(fact_product[rating]))
		dataType: int64
		lineageTag: bcfa1933-d118-4067-8831-f0288026d520
		summarizeBy: none

	column rating_band = IF(ISBLANK(fact_product[rating_band_order]), BLANK(), SWITCH(fact_product[rating_band_order], 0, "0 to <1", 1, "1 to <2", 2, "2 to <3", 3, "3 to <4", 4, "4 to <5", 5, "5"))
		dataType: string
		lineageTag: 56f89a8e-2867-4058-a9a8-758aab919728
		summarizeBy: none
		sortByColumn: rating_band_order

	column listing_compact = LEFT(fact_product[product_name], 38) & IF(LEN(fact_product[product_name]) > 38, "…", "") & " · " & IF(fact_product[marketplace] = "flipkart", "FK ", "MY ") & fact_product[source_product_id]
		dataType: string
		lineageTag: d98e407f-4628-45c0-b452-3f860650efe6
		summarizeBy: none

	column scatter_bin = VAR Price = fact_product[recorded_price] VAR Stars = fact_product[rating] RETURN IF(NOT ISBLANK(Price) && NOT ISBLANK(Stars), INT(LOG10(1 + Price) * 5) & "|" & INT(Stars * 5))
		dataType: string
		lineageTag: 07b43b7f-9d65-4dd0-99ab-bb823f039eea
		summarizeBy: none

	partition fact_product = m
		mode: import
		source =
				let
					Folder = if DataFolder = "SET_DATA_FOLDER" then error "Set DataFolder to the full powerbi/data path before refresh." else DataFolder,
					Raw = Csv.Document(File.Contents(Folder & "/fact_product.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"product_id", Int64.Type}, {"marketplace", type text}, {"source_product_id", type text}, {"product_name", type text}, {"brand_id", Int64.Type}, {"category_id", Int64.Type}, {"price_band_id", Int64.Type}, {"colour", type text}, {"recorded_price_field", type text}, {"recorded_price", Currency.Type}, {"retail_price", Currency.Type}, {"discounted_price", Currency.Type}, {"discount_amount", Currency.Type}, {"discount_fraction", type number}, {"rating", type number}, {"overall_rating", type number}, {"rating_count", Int64.Type}, {"has_rating", Int64.Type}, {"has_overall_rating", Int64.Type}, {"has_rating_count", Int64.Type}, {"missing_recorded_price", Int64.Type}, {"missing_retail_price", Int64.Type}, {"missing_brand", Int64.Type}, {"missing_category", Int64.Type}, {"missing_attributes", Int64.Type}, {"missing_colour", Int64.Type}, {"missing_observation_date", Int64.Type}, {"has_conflicts", Int64.Type}, {"observed_at", type text}, {"product_url", type text}, {"attributes_json", type text}}, "en-US")
				in
					Typed
