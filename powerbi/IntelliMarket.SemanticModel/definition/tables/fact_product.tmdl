table fact_product
	lineageTag: e95cd5fc-c654-4f5c-99e9-ccd79ae72478

	measure 'Product Count' = COUNTROWS(fact_product)
		formatString: #,0
		lineageTag: d0b188a5-5593-467a-9f2b-981099465e2c

	measure 'Flipkart Products' = CALCULATE([Product Count], KEEPFILTERS(dim_marketplace[marketplace] = "flipkart"))
		formatString: #,0
		lineageTag: ac1830d0-98f3-448a-be49-e9eb4cfcd5c2

	measure 'Myntra Products' = CALCULATE([Product Count], KEEPFILTERS(dim_marketplace[marketplace] = "myntra"))
		formatString: #,0
		lineageTag: d96e183c-68d8-4f8e-bb3a-6f062400d1de

	measure 'Known Brands' = CALCULATE(DISTINCTCOUNT(fact_product[brand_id]), KEEPFILTERS(fact_product[brand_id] <> 0))
		formatString: #,0
		lineageTag: a9fe4321-82d2-4249-9c7c-47954dc94636

	measure 'Categories Recorded' = CALCULATE(DISTINCTCOUNT(fact_product[category_id]), KEEPFILTERS(fact_product[category_id] <> 0))
		formatString: #,0
		lineageTag: 12ede8c6-d0ca-44b2-8973-470f74833cc3

	measure 'Marketplace Share' = DIVIDE([Product Count], CALCULATE([Product Count], REMOVEFILTERS(dim_marketplace)))
		formatString: 0.0%
		lineageTag: 3eb4c09e-f2b5-414d-8902-cae6bcd127c4

	measure 'Priced Products' = COUNT(fact_product[recorded_price])
		formatString: #,0
		lineageTag: e6f0071f-3c1c-4a47-a28d-03a96f99f7d6

	measure 'Price Coverage' = DIVIDE([Priced Products], [Product Count])
		formatString: 0.0%
		lineageTag: 186e0afd-93fb-4e82-9ebe-70191f218164

	measure 'Average Recorded Price' = AVERAGE(fact_product[recorded_price])
		formatString: #,0.00
		lineageTag: a5611f12-1a18-41cb-b8d4-1d1bdb2a87c7

	measure 'Median Recorded Price' = MEDIAN(fact_product[recorded_price])
		formatString: #,0.00
		lineageTag: 4fa69cdc-10cf-456b-9122-c9ddfa1b4463

	measure 'Discount Eligible Products' = COUNT(fact_product[discount_fraction])
		formatString: #,0
		lineageTag: 5a031813-a132-42aa-bf48-79644c4d5586

	measure 'Discounted Products' = CALCULATE([Product Count], KEEPFILTERS(fact_product[discount_fraction] > 0))
		formatString: #,0
		lineageTag: 59d67cf4-071f-4aee-9d4e-a8644f984206

	measure 'Average Valid Discount' = AVERAGE(fact_product[discount_fraction])
		formatString: 0.0%
		lineageTag: 3bfd9632-9bd4-4d2b-b0fc-256d61f1bcf7

	measure 'Recorded Retail Price' = SELECTEDVALUE(fact_product[retail_price])
		formatString: #,0.00
		lineageTag: c746ec75-b409-4a60-b9f0-e879e516b573

	measure 'Recorded Listing Price' = SELECTEDVALUE(fact_product[recorded_price])
		formatString: #,0.00
		lineageTag: f2e485e3-e112-4a2e-90b3-00b9477fbb60

	measure 'Listing Discount Amount' = SELECTEDVALUE(fact_product[discount_amount])
		formatString: #,0.00
		lineageTag: 7e92bf06-1621-4019-8807-5b8b8e54a9c9

	measure 'Rated Products' = SUM(fact_product[has_rating])
		formatString: #,0
		lineageTag: 05f839aa-ea79-4be1-95b5-a757e33e2ffb

	measure 'Rating Coverage' = DIVIDE([Rated Products], [Product Count])
		formatString: 0.0%
		lineageTag: bbf0f13d-e392-4ad3-b871-f86bb7623f62

	measure 'Average Recorded Rating' = AVERAGE(fact_product[rating])
		formatString: #,0.00
		lineageTag: 63eafa22-8740-4638-9843-0b4db500d3db

	measure 'Products With Rating Count' = SUM(fact_product[has_rating_count])
		formatString: #,0
		lineageTag: ee5193af-f11e-4739-9bdb-d6dd3ffdc44b

	measure 'Reported Rating Count' = SUM(fact_product[rating_count])
		formatString: #,0
		lineageTag: d3ce51c7-8929-4818-8827-d58080b1500e

	measure 'Missing Rating' = [Product Count] - [Rated Products]
		formatString: #,0
		lineageTag: d1786072-68c5-4fad-a9be-66e7ad76902b

	measure 'Missing Attributes' = SUM(fact_product[missing_attributes])
		formatString: #,0
		lineageTag: b45f61e7-d5bd-4b04-b007-002f47df6484

	measure 'Category Coverage' = DIVIDE([Product Count] - SUM(fact_product[missing_category]), [Product Count])
		formatString: 0.0%
		lineageTag: 0b27d599-7a44-45d5-bac6-a420730ce5a2

	measure 'Brand Coverage' = DIVIDE([Product Count] - SUM(fact_product[missing_brand]), [Product Count])
		formatString: 0.0%
		lineageTag: 27ff39b1-6ae7-4cac-8d2b-8875bda641a0

	measure 'Attribute Coverage' = DIVIDE([Product Count] - [Missing Attributes], [Product Count])
		formatString: 0.0%
		lineageTag: aca8dce5-78af-452a-ace9-e11a713b735b

	measure 'Shared Category' =
			VAR Label = SELECTEDVALUE(dim_category[comparison_category])
			VAR Flipkart = CALCULATE([Priced Products], REMOVEFILTERS(dim_marketplace), dim_marketplace[marketplace] = "flipkart")
			VAR Myntra = CALCULATE([Priced Products], REMOVEFILTERS(dim_marketplace), dim_marketplace[marketplace] = "myntra")
			RETURN IF(NOT ISBLANK(Label) && Flipkart > 0 && Myntra > 0, 1, 0)
		formatString: #,0
		lineageTag: 54e32bf0-c250-412a-8203-0d862364bcfa

	measure 'Ranking Rating' = IF(HASONEVALUE(fact_product[product_id]) && SELECTEDVALUE(fact_product[rating_count]) >= 10, SELECTEDVALUE(fact_product[rating]))
		formatString: #,0.00
		lineageTag: 9b0d2d2e-e0f0-4ea7-aeca-1ae02d362710

	measure 'Ranking Rating Count' = IF(NOT ISBLANK([Ranking Rating]), SELECTEDVALUE(fact_product[rating_count]))
		formatString: #,0
		lineageTag: 87faca35-bcbf-40f9-9dae-3bfcb4814aaf

	measure 'Comparable Priced Listings' = IF([Shared Category] = 1, [Priced Products])
		formatString: #,0
		lineageTag: ee408b7c-c9a8-4c56-95d0-023dcfa4969a

	measure 'Comparable Median Price' = IF([Shared Category] = 1, [Median Recorded Price])
		formatString: #,0.00
		lineageTag: ebb16b85-0c24-4b3e-9301-85bdb18e3438

	measure 'Comparable Average Price' = IF([Shared Category] = 1, [Average Recorded Price])
		formatString: #,0.00
		lineageTag: f1c89dc9-cdd6-46dd-ad40-2e5d55b451e8

	measure 'Log Recorded Price' = AVERAGEX(FILTER(fact_product, NOT ISBLANK(fact_product[recorded_price])), LOG10(1 + fact_product[recorded_price]))
		formatString: #,0.00
		lineageTag: 04ec0960-eed2-4097-9803-fbf5d39b87a5

	measure 'Minimum Recorded Price' = MIN(fact_product[recorded_price])
		formatString: #,0.00
		lineageTag: d642f4f6-e10c-45c8-b7aa-c44f3d1f2d9b

	measure 'Maximum Recorded Price' = MAX(fact_product[recorded_price])
		formatString: #,0.00
		lineageTag: 16dc8232-52ae-4ff5-be49-69ad19fce2e4

	measure 'Flipkart Median Recorded Price' = CALCULATE([Median Recorded Price], KEEPFILTERS(dim_marketplace[marketplace] = "flipkart"))
		formatString: #,0.00
		lineageTag: e6037368-3b6f-4c02-b9fe-8405425d4203

	measure 'Myntra Median Recorded Price' = CALCULATE([Median Recorded Price], KEEPFILTERS(dim_marketplace[marketplace] = "myntra"))
		formatString: #,0.00
		lineageTag: 142ce536-7923-40d7-ba04-d84ba9057ddf

