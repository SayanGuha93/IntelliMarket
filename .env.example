# Django settings. Generate a private random secret for deployment; never commit it.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_COOKIE_SAMESITE=Lax
ANON_API_RATE=120/hour

# Set to the existing catalog file. This must be writable by ingestion processes,
# while API requests open it read-only.
INTELLIMARKET_DB_PATH=./prices.db

# Google Identity Services OAuth client ID (public client ID, not a secret).
GOOGLE_CLIENT_ID=
GOOGLE_BOOKS_API_KEY=

# RAG FastAPI service should be private and use one worker with the current
# process-local session implementation.
RAG_API_URL=http://127.0.0.1:8001
# Optional exact host allowlist for private-network HTTP services (host only, no port).
RAG_API_ALLOWED_HOSTS=

# Power BI app-owns-data embedding. Configure only after publishing the report.
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=
PBI_REPORT_IDS=
POWERBI_ALLOWED_USER_EMAILS=
